@startuml use-case-diagram
' ============================================================
' Use Case Diagram — LMS Mobile (Gamified Learning Platform)
' Aktor: Guest, Learner/Creator, Admin
' Catatan: seluruh fitur Learner & Admin mensyaratkan "Login"
'          (relasi <<include>> disederhanakan agar diagram mudah dibaca).
' ============================================================
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
skinparam usecase {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
  ArrowColor #4F46E5
}

actor "Guest" as guest
actor "Learner / Creator" as learner
actor "Admin" as admin

rectangle "LMS Mobile" {

  usecase "Login / Registrasi" as UC_Login
  usecase "Meramban Katalog Materi" as UC_Browse
  usecase "Melihat Papan Peringkat" as UC_Leaderboard

  usecase "Membaca Detail Materi (Markdown)" as UC_Read
  usecase "Mencari & Memfilter Materi" as UC_Search
  usecase "Menandai Selesai & Klaim EXP" as UC_Complete
  usecase "Memberi Rating (1-5)" as UC_Rate
  usecase "Menulis Komentar" as UC_Comment
  usecase "Membuat / Mengubah Materi" as UC_Create
  usecase "Mengelola Materi Saya" as UC_MyMaterials
  usecase "Mengelola Profil" as UC_Profile

  usecase "Melihat Antrean Moderasi" as UC_Queue
  usecase "Approve / Reject Materi" as UC_Moderate
  usecase "Mengelola Kategori" as UC_Category
  usecase "Melihat Statistik Sistem" as UC_Stats
}

' --- Guest ---
guest --> UC_Browse
guest --> UC_Leaderboard
guest --> UC_Login

' --- Learner / Creator ---
learner --> UC_Read
learner --> UC_Search
learner --> UC_Complete
learner --> UC_Rate
learner --> UC_Comment
learner --> UC_Create
learner --> UC_MyMaterials
learner --> UC_Profile

' --- Admin ---
admin --> UC_Queue
admin --> UC_Moderate
admin --> UC_Category
admin --> UC_Stats

' --- Relasi antar Use Case (extend) ---
UC_Moderate ..> UC_Queue : <<extend>>

' --- Catatan: semua fitur Learner & Admin <<include>> "Login/Registrasi" ---

@enduml
